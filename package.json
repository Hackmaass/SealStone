{
  "name": "milestonevault",
  "private": true,
  "version": "0.0.0",
  "description": "MilestoneVault: adversarial smart-contract escrow (VORTEXA 3.0, B-03)",
  "workspaces": [
    "shared",
    "contracts",
    "server",
    "web"
  ],
  "scripts": {
    "setup": "npm install",
    "chain": "npm run node --workspace contracts",
    "deploy:demo": "npm run deploy:demo --workspace contracts",
    "test:contracts": "npm run test --workspace contracts",
    "coverage": "npm run coverage --workspace contracts",
    "server": "npm run dev --workspace server",
    "web": "npm run dev --workspace web",
    "dev": "node scripts/todo.mjs P11",
    "eval:ai": "node scripts/todo.mjs P06",
    "demo:reset": "npm run reset --workspace contracts",
    "test:shared": "npm run test --workspace shared",
    "auto-commit": "node scripts/auto-commit.mjs",
    "auto-commit:dry": "node scripts/auto-commit.mjs --dry-run"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "rimraf": "^6.0.0"
  }
}
